{
  "name": "kosmoskopos",
  "private": true,
  "version": "0.1.0",
  "description": "Kosmoskopos \u2014 a live humanitarian watch over the whole planet: a photorealistic 3D globe fusing public data (aircraft, vessels, satellites, earthquakes, active fires, weather, disaster alerts) with a voice AI analyst, for situational awareness and disaster response.",
  "type": "module",
  "license": "MIT",
  "author": "Marco Ayuste",
  "engines": {
    "node": ">=24.22.1 <25 || >=26.12.1 <27"
  },
  "keywords": [
    "cesium",
    "3d-globe",
    "geospatial",
    "osint",
    "spatial-intelligence",
    "photorealistic-3d-tiles",
    "adsb",
    "ais",
    "satellites",
    "voice-control",
    "openai-realtime",
    "visualization"
  ],
  "scripts": {
    "dev": "vite",
    "dev:secure": "./scripts/dev-secure.sh",
    "opensky:import": "./scripts/opensky-import-client.sh",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node scripts/run-unit-tests.mjs",
    "test:track": "node scripts/track-regression.mjs",
    "qa:map-source-tray": "node scripts/qa-map-source-tray.mjs",
    "start": "vite"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@mlc-ai/web-llm": "^0.2.84",
    "cesium": "^1.124.0",
    "egm96-universal": "^1.1.1",
    "mgrs": "^2.1.0",
    "pbf": "^5.1.2",
    "satellite.js": "^6.0.2",
    "vite": "^6.0.0",
    "vite-plugin-cesium": "^1.2.23",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "puppeteer": "^24.37.5",
    "sharp": "^0.34.5"
  }
}
