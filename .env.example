# CrisisScape — copy to .env and add your FREE keys. No billing anywhere.
# Required: Cesium ion token (free Community) — https://ion.cesium.com/tokens
CESIUM_ION_TOKEN=
# Google Maps key: leave EMPTY (needs billing). CrisisScape uses Cesium ion instead.
GOOGLE_MAPS_API_KEY=
# Free AI analyst — Gemini: https://aistudio.google.com/app/apikey  then Groq: https://console.groq.com/keys
GEMINI_API_KEY=
GROQ_API_KEY=
# NASA FIRMS wildfires (free) — https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# Live vessels (free, optional) — https://aisstream.io
AISSTREAM_API_KEY=
# Optional local model (OpenAI-compatible server, e.g. llama.cpp/Ollama) for an offline analyst
# LOCAL_LLM_URL=http://127.0.0.1:8080
# LOCAL_LLM_MODEL=local
# Server bind — for a deploy set HOST=0.0.0.0 (platform provides PORT)
PORT=4173
# Guardrail: per-IP analyst rate limit (protects the free quota on a public deploy)
ANALYST_RATELIMIT_PER_MIN=15
